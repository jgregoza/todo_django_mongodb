# Django Settings
# Genera una clave aleatoria para producción. No uses este valor.
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Rutas mutables (producción: /home/jzamora/taskpilot-data)
# DATA_DIR=/home/jzamora/taskpilot-data
# STATIC_ROOT=/home/jzamora/taskpilot/staticfiles

# Orígenes de confianza para CSRF
CSRF_TRUSTED_ORIGINS=https://jzamora.pythonanywhere.com

# Caducidad de la sesión por inactividad, en segundos (8 h por defecto)
# SESSION_COOKIE_AGE=28800

# Timeout de la caché en memoria, en segundos (300 por defecto)
# CACHE_TIMEOUT=300
