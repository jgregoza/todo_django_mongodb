# Django Settings
SECRET_KEY=django-insecure-todo-list-mongodb-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# MongoDB Connection
# Opción 1: MongoDB Local
MONGO_URI=mongodb://localhost:27017/todo_db

